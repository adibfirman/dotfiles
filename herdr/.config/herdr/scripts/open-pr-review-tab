#!/bin/sh
set -eu

HERDR_BIN=${HERDR_BIN_PATH:-herdr}
scripts_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

notify() {
  "$HERDR_BIN" notification show "$1" --body "${2:-}" >/dev/null 2>&1 || true
}

fail() {
  notify "Open review failed" "$1"
  exit 1
}

# Print $1 as one single-quoted shell word.
sh_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

cwd=${HERDR_ACTIVE_PANE_CWD:-$(pwd)}
[ -d "$cwd" ] || fail "active pane cwd is missing"

for tool in gh git hunk python3; do
  command -v "$tool" >/dev/null 2>&1 || fail "$tool is not installed"
done

workspace=${HERDR_ACTIVE_WORKSPACE_ID:-}
[ -n "$workspace" ] || fail "active workspace id is missing"

if ! root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
  notify "Not a git repository" "active pane is not in a git repository"
  exit 0
fi

errfile=$(mktemp)
trap 'rm -f "$errfile"' EXIT HUP INT TERM

# Review view rule:
# - PR view wins only when a PR exists AND the branch is clean.
# - Otherwise open a local diff against the merge base with origin/<base>.
#   With no PR, <base> is the nearest parent branch, or the trunk.
# Dirty = working tree changes (staged, unstaged, untracked), no upstream,
# or commits ahead of upstream.
is_dirty() {
  [ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ] && return 0
  upstream=$(git -C "$root" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) || return 0
  [ -n "$(git -C "$root" rev-list "$upstream..HEAD" 2>/dev/null)" ]
}

if ! pr_json=$(cd "$root" && gh pr view --json url,baseRefName 2>"$errfile"); then
  pr_json=
  if ! grep -qE "no pull requests found|could not determine current branch" "$errfile"; then
    fail "$(head -n 1 "$errfile")"
  fi
fi

# Close the new tab on failure so no empty hunk tab is left behind.
fail_and_close_tab() {
  "$HERDR_BIN" tab close "$new_tab" >/dev/null 2>&1 || true
  fail "$1"
}

# Focus the tab with this label and exit, when it exists.
focus_tab_if_open() {
  tab_label=$1
  tabs=$("$HERDR_BIN" tab list --workspace "$workspace") || fail "could not list tabs"
  tab_id=$(printf '%s' "$tabs" | LABEL="$tab_label" python3 -c '
import json, os, sys
for t in json.load(sys.stdin)["result"]["tabs"]:
    if t.get("label") == os.environ["LABEL"]:
        print(t["tab_id"])
        break
') || fail "could not read tab list"

  if [ -n "$tab_id" ]; then
    "$HERDR_BIN" tab focus "$tab_id" >/dev/null || fail "could not focus tab $tab_id"
    exit 0
  fi
}

# Create and focus a tab with this label.
# Sets: new_tab, pane_id.
create_tab() {
  tab_label=$1
  created=$("$HERDR_BIN" tab create --workspace "$workspace" --cwd "$root" --label "$tab_label" --focus) ||
    fail "could not create tab"
  # Print "<tab id> <pane id>"; the pane id stays empty when it is missing.
  create_info=$(printf '%s' "$created" | python3 -c '
import json, sys

try:
    result = json.load(sys.stdin)["result"]
    tab_id = result["tab"]["tab_id"]
except (ValueError, KeyError, TypeError):
    sys.exit(1)
pane = result.get("root_pane")
pane_id = pane.get("pane_id") if isinstance(pane, dict) else None
print(tab_id, pane_id or "")
') || fail "could not read tab create result"
  IFS=' ' read -r new_tab pane_id <<EOF
$create_info
EOF
  [ -n "$pane_id" ] || fail_and_close_tab "tab create returned no pane id"
}

# Focus the tab with this label and exit, or create it.
# Sets: new_tab, pane_id.
open_or_focus_tab() {
  focus_tab_if_open "$1"
  create_tab "$1"
}

# Print the nearest origin branch in HEAD's history that is not in
# origin/<trunk>, or nothing. This finds the parent of a stacked branch.
# A parent that got new commits after the branch was made is missed, and a
# branch pushed under another name can pick its own pushed ref.
find_parent_branch() {
  trunk=$1
  git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$trunk" || return 0
  current=$(git -C "$root" symbolic-ref --quiet --short HEAD) || current=
  refs=$(git -C "$root" for-each-ref --merged HEAD --no-merged "refs/remotes/origin/$trunk" \
    --format='%(refname)' refs/remotes/origin) || return 0
  best=
  best_count=
  while IFS= read -r ref; do
    name=${ref#refs/remotes/origin/}
    case $name in
    '' | HEAD | "$trunk" | "$current") continue ;;
    esac
    count=$(git -C "$root" rev-list --count "$ref..HEAD") || continue
    # Count 0: the ref points at HEAD, so it is not a parent.
    [ "$count" -gt 0 ] || continue
    if [ -z "$best_count" ] || [ "$count" -lt "$best_count" ]; then
      best=$name
      best_count=$count
    fi
  done <<EOF
$refs
EOF
  printf '%s\n' "$best"
}

if [ -z "$pr_json" ] || is_dirty; then
  # Local view: diff the working tree against the merge base with origin/<base>.
  # An open "hunk local" tab is focused before any base lookup or fetch.
  focus_tab_if_open "hunk local"
  base=
  if [ -n "$pr_json" ]; then
    base=$(printf '%s' "$pr_json" | python3 -c '
import json, sys
print(json.load(sys.stdin).get("baseRefName") or "")
') || base=
  fi
  if [ -z "$base" ]; then
    base=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || base=
    base=${base#origin/}
  fi
  if [ -z "$base" ]; then
    base=$(cd "$root" && gh repo view --json defaultBranchRef --jq .defaultBranchRef.name 2>/dev/null) || base=
  fi
  [ -n "$base" ] || fail "could not find base branch"

  # No PR: a hand-made stacked branch has its parent branch in its history.
  parent=
  if [ -z "$pr_json" ]; then
    parent=$(find_parent_branch "$base") || parent=
  fi
  [ -z "$parent" ] || base=$parent

  # Fetch here only when origin/<base> is missing. Otherwise the pane
  # fetches it, so the tab opens without waiting on the network.
  if ! git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base"; then
    "$scripts_dir/fetch-base-if-stale" "$root" "$base" || true
  fi
  git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$base" || fail "origin/$base not found"

  # The local origin/<base> can be old here; hunk-local-diff computes the
  # merge base again after its fetch.
  merge_base=$(git -C "$root" merge-base "origin/$base" HEAD) ||
    fail "could not find merge base with origin/$base"

  if git -C "$root" diff --quiet "$merge_base" &&
    [ -z "$(git -C "$root" ls-files --others --exclude-standard)" ]; then
    notify "No changes" "No local changes against origin/$base"
    exit 0
  fi

  [ -z "$parent" ] || notify "Base: origin/$base" "No PR yet, so the diff uses the nearest parent branch"
  create_tab "hunk local"
  # exec replaces the pane shell, so the tab closes when hunk-local-diff ends,
  # also after Ctrl-C or an error. No dead "hunk local" tab is left behind.
  pane_cmd="exec $(sh_quote "$scripts_dir/hunk-local-diff") $(sh_quote "$root") $(sh_quote "$base")"
  "$HERDR_BIN" pane run "$pane_id" "$pane_cmd" >/dev/null ||
    fail_and_close_tab "could not run hunk in pane $pane_id"
  exit 0
fi

pr_info=$(printf '%s' "$pr_json" | python3 -c '
import json, re, sys

data = json.load(sys.stdin)
match = re.match(r"https://github\.com/([^/]+)/([^/]+)/pull/(\d+)", str(data.get("url") or ""))
print(" ".join(match.groups()))
') || fail "could not parse PR url"
IFS=' ' read -r pr_owner pr_repo number <<EOF
$pr_info
EOF
repo=$pr_owner/$pr_repo

open_or_focus_tab "hunk #$number"

# Inline review threads: open, current threads become hunk agent notes.
# Failures here never block the review; the tab opens with plain hunk.
# A private (0700) dir per run keeps the sidecar path unique and unguessable.
# It stays after the run: hunk re-reads the file on reload.
threads_dir=$(mktemp -d "${TMPDIR:-/tmp}/hunk-gh-threads.XXXXXX" 2>/dev/null) || threads_dir=
threads_file=$threads_dir/$pr_owner-$pr_repo-$number.json

# shellcheck disable=SC2016
threads_query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){reviewThreads(first:100){nodes{isResolved isOutdated path line startLine diffSide comments(first:100){nodes{author{login} body}}}}}}}'

# Print the number of notes written to $threads_file.
load_threads() {
  if [ -z "$threads_dir" ]; then
    echo "could not create temp dir" >&2
    return 1
  fi
  case $threads_file in
  *\'*)
    echo "temp path contains a quote" >&2
    return 1
    ;;
  esac
  threads_json=$(gh api graphql -f query="$threads_query" -f owner="$pr_owner" -f name="$pr_repo" -F number="$number") ||
    return 1
  printf '%s' "$threads_json" | THREADS_FILE="$threads_file" PR_NUMBER="$number" PR_REPO="$repo" python3 -c '
import json, os, re, sys

# An unclosed "<!--" runs to the end: no rescan, so no quadratic backtracking.
HTML_COMMENT = re.compile(r"<!--.*?(?:-->|\Z)", re.S)
# Innermost first: no nested <details> may start before the first closing tag.
DETAILS = re.compile(r"<details(?=[\s>])(?:(?!<details[\s>]).)*?</details>", re.S | re.I)


def clean(text):
    text = (text or "").replace("\r\n", "\n")
    text = HTML_COMMENT.sub("", text)
    while True:
        text, count = DETAILS.subn("", text)
        if not count:
            break
    return re.sub(r"\n(?:[ \t]*\n){2,}", "\n\n", text).strip()


def login(comment):
    return "@" + ((comment.get("author") or {}).get("login") or "ghost")


class PullRequestNotFound(Exception):
    pass


def convert(data):
    if data.get("errors"):
        raise ValueError(data["errors"][0].get("message", "GraphQL error"))
    repository = (data.get("data") or {}).get("repository") or {}
    pull = repository.get("pullRequest")
    if not pull:
        raise PullRequestNotFound("PR #%s not found in %s" % (os.environ["PR_NUMBER"], os.environ["PR_REPO"]))
    files = {}
    total = 0
    for thread in pull["reviewThreads"]["nodes"]:
        line = thread.get("line")
        comments = (thread.get("comments") or {}).get("nodes") or []
        if thread.get("isResolved") or thread.get("isOutdated") or not comments:
            continue
        if not isinstance(line, int) or not thread.get("path"):
            continue
        start = thread.get("startLine")
        if not isinstance(start, int):
            start = line
        low, high = sorted((max(1, start), max(1, line)))
        first = comments[0]
        note = {
            "author": login(first),
            "summary": clean(first.get("body")) or "(empty comment)",
        }
        replies = []
        for reply in comments[1:]:
            body = clean(reply.get("body"))
            if body:
                replies.append("\u21b3 " + login(reply) + ": " + body)
        if replies:
            note["rationale"] = "\n\n".join(replies)
        side = "oldRange" if thread.get("diffSide") == "LEFT" else "newRange"
        note[side] = [low, high]
        files.setdefault(thread["path"], []).append(note)
        total += 1
    return total, {
        "version": 1,
        "files": [{"path": p, "annotations": a} for p, a in files.items()],
    }


try:
    total, sidecar = convert(json.load(sys.stdin))
    path = os.environ["THREADS_FILE"]
    if total:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            json.dump(sidecar, out, indent=2)
            out.write("\n")
    print(total)
except PullRequestNotFound as exc:
    sys.exit(str(exc))
except Exception as exc:
    sys.exit("could not convert PR threads: %s" % exc)
'
}

if ! open_threads=$(load_threads 2>"$errfile"); then
  open_threads=0
  notify "PR threads not loaded" "$(head -n 1 "$errfile")"
fi

hunk_flags=
if [ "$open_threads" -gt 0 ]; then
  hunk_flags=" -- --agent-context '$threads_file' --agent-notes"
fi

# The pane shell expands $(gh auth token); this script never reads the token.
# shellcheck disable=SC2016
cmd='GH_TOKEN="$(gh auth token)" GH_PR_NUMBER='"$number"' GH_PR_REPO='"$repo"' hunk gh pr '"$number"' --repo '"$repo$hunk_flags"' && exit'
"$HERDR_BIN" pane run "$pane_id" "$cmd" >/dev/null || fail_and_close_tab "could not run hunk in pane $pane_id"
