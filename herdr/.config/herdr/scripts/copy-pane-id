#!/bin/sh
set -eu

HERDR_BIN=${HERDR_BIN_PATH:-herdr}
action=${1:-copy}

notify() {
  "$HERDR_BIN" notification show "$1" --body "${2:-}" >/dev/null 2>&1 || true
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    notify "Copy pane id failed" "$1 is not installed"
    exit 1
  fi
}

require_cmd herdr
require_cmd python3
require_cmd fzf

if [ "$action" = "copy" ]; then
  require_cmd pbcopy
fi

tmp_file=${TMPDIR:-/tmp}/herdr-copy-pane-id.$$
trap 'rm -f "$tmp_file"' EXIT HUP INT TERM

herdr pane list | python3 -c '
import json, os, sys

try:
    panes_data = json.load(sys.stdin)["result"]["panes"]
except Exception:
    raise SystemExit(1)

workspaces = {}
try:
    import subprocess
    ws_raw = subprocess.check_output(
        [os.environ.get("HERDR_BIN_PATH", "herdr"), "workspace", "list"],
        text=True
    )
    ws_list = json.loads(ws_raw)["result"]["workspaces"]
    for ws in ws_list:
        workspaces[ws["workspace_id"]] = ws
except Exception:
    pass

rows = []

for pane in panes_data:
    pane_id = pane.get("pane_id", "")
    cwd = pane.get("cwd", "")
    workspace_id = pane.get("workspace_id", "")
    ws = workspaces.get(workspace_id, {})
    wt = ws.get("worktree")

    if wt and wt.get("is_linked_worktree"):
        worktree_dir = cwd.rsplit("/", 1)[-1] if "/" in cwd else cwd
        parent_worktree = wt.get("repo_name", "")
    else:
        worktree_dir = "-"
        parent_worktree = wt.get("repo_name", "") if wt else ws.get("label", "")

    label = ws.get("label", "")
    rows.append((pane_id, worktree_dir, parent_worktree, label, workspace_id, pane.get("tab_id", "")))

headers = ("PANE_ID", "WORKTREE DIR", "PARENT WORKTREE", "LABEL")
widths = [
    max(len(headers[index]), max((len(row[index]) for row in rows), default=0))
    for index in range(len(headers))
]

print("  ".join(value.ljust(widths[index]) for index, value in enumerate(headers)))
for row in rows:
    display = "  ".join(row[index].ljust(widths[index]) for index in range(len(headers)))
    print(display + "\t" + row[3] + "\t" + row[4] + "\t" + row[5])
' > "$tmp_file"

if [ ! -s "$tmp_file" ]; then
  notify "Copy pane id failed" "no panes found"
  exit 1
fi

selection=$(fzf \
  --prompt="$action pane> " \
  --header-lines=1 \
  --layout=reverse \
  --border \
  --no-mouse \
  --delimiter='\t' \
  --with-nth=1 \
  < "$tmp_file" || true)

if [ -z "$selection" ]; then
  exit 0
fi

pane_id=$(printf '%s\n' "$selection" | awk '{print $1}')
label=$(printf '%s\n' "$selection" | awk -F '\t' '{print $2}')
workspace_id=$(printf '%s\n' "$selection" | awk -F '\t' '{print $3}')
tab_id=$(printf '%s\n' "$selection" | awk -F '\t' '{print $4}')

if [ -z "$pane_id" ]; then
  notify "Copy pane id failed" "could not parse pane id"
  exit 1
fi

case "$action" in
copy)
  printf '%s:%s' "$label" "$pane_id" | pbcopy
  notify "Pane copied" "$label:$pane_id"
  ;;
go)
  "$HERDR_BIN" workspace focus "$workspace_id" >/dev/null
  "$HERDR_BIN" tab focus "$tab_id" >/dev/null

  layout=$("$HERDR_BIN" pane layout --pane "$pane_id")
  current=$(printf '%s' "$layout" | python3 -c '
import json, sys
print(json.load(sys.stdin)["result"]["layout"]["focused_pane_id"])
')

  while [ "$current" != "$pane_id" ]; do
    direction=$(CURRENT="$current" TARGET="$pane_id" LAYOUT="$layout" python3 -c '
import json, os, sys

layout = json.loads(os.environ["LAYOUT"])["result"]["layout"]
panes = {pane["pane_id"]: pane["rect"] for pane in layout["panes"]}
current = panes[os.environ["CURRENT"]]
target = panes[os.environ["TARGET"]]

current_x = current["x"] + current["width"] / 2
current_y = current["y"] + current["height"] / 2
target_x = target["x"] + target["width"] / 2
target_y = target["y"] + target["height"] / 2

if target_x > current_x:
    print("right")
elif target_x < current_x:
    print("left")
elif target_y > current_y:
    print("down")
else:
    print("up")
')
    "$HERDR_BIN" pane focus --pane "$current" --direction "$direction" >/dev/null
    current=$("$HERDR_BIN" pane layout --pane "$pane_id" | python3 -c '
import json, sys
print(json.load(sys.stdin)["result"]["layout"]["focused_pane_id"])
')
  done
  ;;
*)
  notify "Pane action failed" "unknown action: $action"
  exit 1
  ;;
esac
